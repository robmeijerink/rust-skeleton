{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(task:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(task cargo -- add:*)"
    ],
    "deny": [
      "Bash(cargo:*)",
      "Bash(rustc:*)",
      "Bash(task dev:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./*.env)"
    ]
  }
}
