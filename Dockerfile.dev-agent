# syntax=docker/dockerfile:1

# Sandbox for Claude Code (`task agent`); a dev tool, not part of the app.
# Deliberately not pinned: `task agent:update` rebuilds it with the latest Claude Code.
FROM rust:1-trixie

# The sandbox has no Docker, so `task` (as used in AGENTS.md and .claude/settings.json)
# runs the same cargo commands directly. Keep in sync with the tasks in Taskfile.yaml.
COPY --chmod=755 <<'EOF' /usr/local/bin/task
#!/bin/sh
set -e
cmd="$1"
if [ $# -gt 0 ]; then shift; fi
if [ "$1" = "--" ]; then shift; fi
case "$cmd" in
  check) cargo fmt --all && cargo clippy -q --locked --all-targets -- -D warnings && cargo test -q --locked ;;
  cargo) exec cargo "$@" ;;
  run) exec cargo run -- "$@" ;;
  test) exec cargo test ;;
  fmt) exec cargo fmt --all ;;
  *) echo "task '$cmd' is not available in the agent sandbox (available: check, cargo, run, test, fmt)" >&2; exit 1 ;;
esac
EOF

# Run as a non-root user (Claude Code refuses auto-approve modes as root). The volumes mounted
# at these paths (see docker-compose.yml) inherit this ownership when they are first created.
# UID is set by Taskfile.yaml (AGENT_UID): your own uid on Linux, so the agent can write to the project.
ARG UID=1000
RUN useradd --create-home --uid "$UID" agent \
    && mkdir -p /app/target /home/agent/.claude \
    && chown -R agent:agent /app /home/agent /usr/local/cargo /usr/local/rustup \
    && git config --system --add safe.directory /app
USER agent
ENV CLAUDE_CONFIG_DIR=/home/agent/.claude

# Native installer (npm installs are deprecated); it installs into ~/.local for the agent user.
# Auto-updates are off: they would be lost when the container is recreated. Use `task agent:update`.
RUN curl -fsSL https://claude.ai/install.sh | bash
ENV PATH=/home/agent/.local/bin:$PATH \
    DISABLE_AUTOUPDATER=1

WORKDIR /app
